# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube a GitHub.

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgresql://emirate:emirate_dev@localhost:5432/emirate_scents"

# Base de datos aparte para las pruebas automáticas (se borra y se vuelve a crear en cada ejecución)
TEST_DATABASE_URL="postgresql://emirate:emirate_dev@localhost:5432/emirate_scents_test"

# Puerto de la API
PORT=4000

# Proxies delante de la API. En tu computador: 0. En el hosting (Render, Railway...): normalmente 1
TRUST_PROXY=0

# Servir la tienda compilada (client/dist) desde esta misma app. En tu computador: false
# (usas "npm run dev"). En producción: true
SERVE_CLIENT=false

# Dirección pública de la tienda, para el mapa del sitio de Google. Obligatoria en producción.
# PUBLIC_URL="https://tudominio.com"

# Dirección de la tienda que puede llamar a la API (separa varias con comas)
CORS_ORIGIN="http://localhost:5173"

# development | production | test
NODE_ENV=development
