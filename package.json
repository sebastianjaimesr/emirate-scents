{
  "name": "emirate-scents",
  "private": true,
  "description": "Tienda online de perfumería premium Emirate Scents",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names api,tienda --prefix-colors yellow,cyan \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces",
    "preview": "npm run preview --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspaces && oxlint e2e playwright.config.ts",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:deploy": "npm run db:deploy --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:studio": "npm run db:studio --workspace server",
    "catalogo:importar": "npm run catalog:import --workspace server --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:informe": "playwright show-report e2e/informe"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  }
}
